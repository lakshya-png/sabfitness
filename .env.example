# SABFITNESS ENVIRONMENT CONFIGURATION
# Tagline: Your fitness journey. Your goals.

# 1. SOLE OWNER ADMIN BOOTSTRAP (Verified Server-side)
# Set this to the exact email address of the sole authorized Owner Admin.
NEXT_PUBLIC_OWNER_ADMIN_EMAIL=owner@sabfitness.app

# 2. SUPABASE POSTGRESQL & AUTH (Optional for local offline mode)
# If provided, the app will automatically synchronize Dexie IndexedDB changes to Supabase PostgreSQL.
# If omitted or left as placeholders, the app functions 100% locally with offline persistence.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# 3. APPLICATION URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. GOOGLE GEMINI AI (Optional for AI-Powered Recipe Creation Assistant)
# Server-side API key for natural language recipe intelligence.
# If omitted or unconfigured, SabFitness automatically runs its built-in rule-based
# heuristic recipe engine with 100% offline uptime and zero external dependencies.
GEMINI_API_KEY=your-gemini-api-key-here

